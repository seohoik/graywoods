---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/landing/Hero.astro';
import EntriesOne from '@/components/entries/EntriesOne.astro';

export async function getStaticPaths({ paginate }) {
  const allPosts = await getCollection('posts');
  const posts = allPosts.filter((p) => !p.data.draft);
  const sortedPosts = posts.sort(
    (a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate)
  );
  return paginate(sortedPosts, { pageSize: 12 });
}

const { page } = Astro.props;
---

<BaseLayout>
  {page.currentPage === 1 && <Hero />}

  <section class="mx-auto mt-12 max-w-7xl px-8 md:px-12 lg:px-32">
    <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {page.data.map((post) => {
        const imageUrl = post.data.heroImage ?? post.data.image?.url;
        const altText = post.data.image?.alt || post.data.title;
        return (
          <EntriesOne
            url={`/posts/${post.slug}`}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate.toISOString()}
            author={post.data.author}
            image={imageUrl}
            alt={altText}
            tags={post.data.tags}
          />
        );
      })}
    </ul>

    <nav class="mt-16 mb-8 flex justify-center items-center gap-4 text-sm">
      {page.url.prev ? (
        <a href={page.url.prev} class="px-4 py-2 rounded-full border border-zinc-300 hover:bg-zinc-100 transition-colors">
          &larr; 이전
        </a>
      ) : (
        <span class="px-4 py-2 rounded-full border border-zinc-100 text-zinc-300 cursor-not-allowed">
          &larr; 이전
        </span>
      )}

      <span class="text-zinc-600">
        {page.currentPage} / {page.lastPage}
      </span>

      {page.url.next ? (
        <a href={page.url.next} class="px-4 py-2 rounded-full border border-zinc-300 hover:bg-zinc-100 transition-colors">
          다음 &rarr;
        </a>
      ) : (
        <span class="px-4 py-2 rounded-full border border-zinc-100 text-zinc-300 cursor-not-allowed">
          다음 &rarr;
        </span>
      )}
    </nav>
  </section>
</BaseLayout>
